# Copy this file to .env and fill in your real values: cp .env.example .env
# .env is git-ignored - it never gets committed, never leaves your machine.
# scripts/run_modal.sh sources it automatically if present.

# Required - training will refuse to start without a working key.
WANDB_API_KEY=your-wandb-key-here

# Optional - if BOTH are set, checkpoints also get pushed to a private
# HuggingFace repo as they save, as extra backup beyond the Modal Volume.
# Leave blank/remove these two lines if you don't want this - training
# works exactly the same either way.
HF_TOKEN=your-huggingface-write-token-here
HF_UPLOAD_REPO=your-username/vlm-pass-k-phase1-checkpoints
